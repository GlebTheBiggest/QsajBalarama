<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.Region?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.qsaj.balarama.v1.controller.LoginController">

    <stylesheets>
        <String fx:value="/css/base.css" />
        <String fx:value="/css/auth.css" />
    </stylesheets>

    <VBox alignment="CENTER" maxWidth="450" spacing="15" styleClass="login-card">

        <VBox alignment="CENTER" spacing="5">
            <Label text="Qsaj Balarama" styleClass="label-title"/>

            <Label fx:id="quoteLabel"
                   text="Loading quote..."
                   styleClass="label-quote"
                   wrapText="true" maxWidth="400"/>
        </VBox>

        <VBox spacing="15">
            <VBox spacing="5">
                <Label text="USERNAME" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                <TextField fx:id="usernameField" promptText="Enter your username" />
            </VBox>

            <VBox spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="PASSWORD" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <Hyperlink text="Forgot password?" styleClass="hyperlink-secondary" onAction="#handleForgotPassword"/>
                </HBox>

                <StackPane alignment="CENTER_RIGHT">
                    <PasswordField fx:id="passwordField" promptText="Enter your password" />

                    <TextField fx:id="passwordTextField" promptText="Enter your password" visible="false" />

                    <Button styleClass="icon-button" onAction="#togglePasswordVisibility">
                        <graphic>
                            <SVGPath fx:id="passwordIcon"
                                     content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                     scaleX="0.7" scaleY="0.7"/>
                        </graphic>
                    </Button>
                </StackPane>
            </VBox>
        </VBox>

        <Button text="LOG IN"
                maxWidth="Infinity"
                styleClass="button-primary"
                defaultButton="true"
                onAction="#handleLogin"/>

        <VBox alignment="CENTER" spacing="5">
            <Hyperlink text="Forgot username?" styleClass="hyperlink-secondary" onAction="#handleForgotUsername"/>
            <Hyperlink text="Create new account"
                       style="-fx-font-size: 13px; -fx-text-fill: #1ABC9C; -fx-border-color: transparent;"
                       onAction="#handleRegister"/>
        </VBox>

    </VBox>
</StackPane>
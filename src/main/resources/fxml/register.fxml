<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.control.ProgressBar?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.qsaj.balarama.v1.controller.RegisterController">

    <stylesheets>
        <String fx:value="/css/base.css" />
        <String fx:value="/css/auth.css" />
    </stylesheets>

    <VBox alignment="CENTER" maxWidth="450" spacing="15" styleClass="login-card">

        <VBox alignment="CENTER" spacing="5">
            <Label text="Create Account" styleClass="label-title"/>
            <Label text="Join Qsaj Balarama today" styleClass="label-quote"/>
        </VBox>

        <VBox spacing="15">
            <VBox spacing="5">
                <Label text="USERNAME" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                <TextField fx:id="usernameField" promptText="Choose a username" />
            </VBox>

            <VBox spacing="5">
                <Label text="EMAIL" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                <TextField fx:id="emailField" promptText="Enter your email address" />
            </VBox>

            <VBox spacing="5">
                <Label text="PASSWORD" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>

                <StackPane alignment="CENTER_RIGHT">
                    <PasswordField fx:id="passwordField" promptText="Create a password" />
                    <TextField fx:id="passwordTextField" promptText="Create a password" visible="false" />

                    <Button styleClass="icon-button" onAction="#togglePasswordVisibility">
                        <graphic>
                            <SVGPath fx:id="passwordIcon"
                                     content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                     scaleX="0.7" scaleY="0.7"/>
                        </graphic>
                    </Button>
                </StackPane>

                <VBox spacing="2">
                    <ProgressBar fx:id="passwordStrengthBar"
                                 maxWidth="Infinity"
                                 progress="0.0"
                                 styleClass="strength-bar-weak"
                                 prefHeight="5"/>
                    <Label fx:id="passwordStrengthLabel"
                           text="Enter password"
                           style="-fx-font-size: 10px; -fx-text-fill: #95a5a6;"/>
                </VBox>
            </VBox>
        </VBox>

        <Button text="REGISTER"
                maxWidth="Infinity"
                styleClass="button-primary"
                defaultButton="true"
                onAction="#handleRegister"/>

        <VBox alignment="CENTER" spacing="5">
            <HBox alignment="CENTER" spacing="5">
                <Label text="Already have an account?" style="-fx-text-fill: #7f8c8d;"/>
                <Hyperlink text="Log in"
                           style="-fx-font-size: 13px; -fx-text-fill: #1ABC9C; -fx-border-color: transparent;"
                           onAction="#handleLoginLink"/>
            </HBox>
        </VBox>

    </VBox>
</StackPane>
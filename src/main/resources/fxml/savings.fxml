<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.qsaj.balarama.v1.controller.SavingsController"
      spacing="20" styleClass="dashboard-container">

    <stylesheets>
        <String fx:value="/css/base.css" />
        <String fx:value="/css/dashboard.css" />
        <String fx:value="/css/savings.css" />
    </stylesheets>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="5">
            <Label text="Savings Goals" styleClass="page-title"/>
            <Label text="Track your dreams." styleClass="page-subtitle"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <VBox spacing="2">
            <Label text="Search Goals" styleClass="input-label"/>
            <TextField fx:id="searchGoalField" promptText="Type goal name..." prefWidth="250"
                       style="-fx-font-size: 14px; -fx-background-radius: 20; -fx-padding: 8 15;"/>
        </VBox>
    </HBox>

    <VBox styleClass="content-card" spacing="15" maxWidth="700">
        <Label text="Create New Goal" styleClass="card-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="goalNameField" promptText="Goal Name" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="targetAmountField" promptText="Target Amount" prefWidth="200"/>
            <Button text="+ Create" styleClass="button-primary" onAction="#handleCreateGoal"/>
        </HBox>
    </VBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="goalsContainer" hgap="20" vgap="20" style="-fx-padding: 10;">
        </FlowPane>
    </ScrollPane>
</VBox>
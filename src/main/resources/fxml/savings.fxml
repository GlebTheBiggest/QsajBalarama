<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.qsaj.balarama.v1.controller.SavingsController"
      spacing="20" styleClass="dashboard-container">

    <stylesheets>
        <String fx:value="/css/base.css" />
        <String fx:value="/css/dashboard.css" />
        <String fx:value="/css/savings.css" />
    </stylesheets>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="5">
            <Label text="Savings Goals" styleClass="page-title"/>
            <Label text="Track your dreams." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox alignment="CENTER_RIGHT" spacing="2">
            <Label text="Total Savings" styleClass="stat-label"/>
            <Label fx:id="totalSavingsLabel" styleClass="stat-value"/>
        </VBox>
    </HBox>

    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="general-savings-card">
        <Label text="💰 Unallocated Savings" styleClass="card-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="unallocatedSavingsLabel" styleClass="stat-value" style="-fx-font-size: 20px;"/>
        <Button fx:id="transferFromUnallocatedBtn" text="Transfer to Goal" styleClass="button-add-funds"/>
        <Button fx:id="transferToMainBtn" text="Transfer to Main" styleClass="button-add-funds"/>
    </HBox>

    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="filter-section">
        <VBox spacing="2" minHeight="70" alignment="TOP_LEFT">
            <Label text="Name" styleClass="input-label"/>
            <TextField fx:id="searchNameField" promptText="Search goal..." prefWidth="200"/>
        </VBox>
        <VBox spacing="2" minHeight="70" alignment="TOP_LEFT">
            <Label text="Min Target" styleClass="input-label"/>
            <TextField fx:id="minTargetField" promptText="From" prefWidth="120"/>
        </VBox>
        <VBox spacing="2" minHeight="70" alignment="TOP_LEFT">
            <Label text="Max Target" styleClass="input-label"/>
            <TextField fx:id="maxTargetField" promptText="To" prefWidth="120"/>
        </VBox>
        <VBox spacing="2" minHeight="70" alignment="TOP_LEFT">
            <Label text=" " styleClass="input-label"/>
            <CheckBox fx:id="showCompletedCheckbox" text="Show completed"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="resetFilterBtn" text="Reset" styleClass="button-reset" onAction="#handleResetFilter"/>
    </HBox>

    <VBox styleClass="content-card" spacing="15" maxWidth="700">
        <Label text="Create New Goal (Envelope)" styleClass="card-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="goalNameField" promptText="Goal Name" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="targetAmountField" promptText="Target Amount" prefWidth="200"/>
            <Button text="+ Create" styleClass="button-primary" onAction="#handleCreateGoal"/>
        </HBox>
    </VBox>

    <ScrollPane fitToWidth="true" styleClass="goals-scroll-pane" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="goalsContainer" hgap="20" vgap="20" styleClass="goals-flow-pane" />
    </ScrollPane>
</VBox>